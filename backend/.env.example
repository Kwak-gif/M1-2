# OpenAI API 설정 (필수)
OPENAI_API_KEY=sk-your-openai-api-key
# 교육 과정 프록시/호환 게이트웨이 키(예: sk-cody-...) 사용 시에만 입력 (일반 OpenAI 키는 비워두기)
# OPENAI_BASE_URL=https://your-openai-compatible-gateway/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=650

# Firebase Firestore 인증 (둘 중 하나 필수)
# 1) 로컬 개발 시: 다운로드한 서비스 계정 JSON 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-key.json
# 2) Render 배포 시: 서비스 계정 JSON 파일 전체 내용을 문자열로 입력
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# CORS 허용 도메인 (콤마로 구분, 배포 시 Vercel 주소 추가 - 끝 슬래시 제외)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# 기본 종목 설정 (PDF 기본 API 테스트 호환용)
DEFAULT_STOCK_SYMBOL=005930
DEFAULT_STOCK_NAME=삼성전자
